# ---------- Directus (docker-compose) ----------
DIRECTUS_SECRET=change-me-long-random-string
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# URL publique de Directus (dev : http://localhost:8055)
DIRECTUS_PUBLIC_URL=http://localhost:8055
# URL du site, autorisée à s'afficher dans l'éditeur visuel Directus
SITE_URL=http://localhost:4321

# ---------- Bootstrap (scripts/bootstrap-directus.ts) ----------
# Token statique attribué à l'utilisateur technique "site-web" (généré par toi : openssl rand -hex 32)
DIRECTUS_WEB_TOKEN=change-me-web-token

# ---------- Site Astro (apps/web) ----------
# URL de Directus vue depuis le serveur Astro
DIRECTUS_URL=http://localhost:8055
# Resend
RESEND_API_KEY=re_xxx
MAIL_FROM="Ohana Lodge <reservation@example.com>"
# Cloudflare Turnstile (clés de test par défaut : passent toujours)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Elloha : disponibilités en direct + paiement en ligne (laisser vide pour rester en mode « demande »)
# Fournis par Elloha (api@elloha.com) ; l'IP du serveur qui appelle l'API doit être déclarée chez eux.
ELLOHA_CLIENT_ID=
ELLOHA_BOOKING_ENGINE_ID=
# Optionnel : identifiant du lodge (IdProduct), retrouvé automatiquement s'il est vide
ELLOHA_PRODUCT_ID=

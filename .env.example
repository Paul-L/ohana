# ---------- Directus (docker-compose) ----------
DIRECTUS_SECRET=change-me-long-random-string
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# URL publique de Directus (dev : http://localhost:8055)
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Prod : hôte dédié aux images (https://media.ohanalodge.com). Vide = DIRECTUS_PUBLIC_URL.
DIRECTUS_ASSETS_URL=
# URL du site, autorisée à s'afficher dans l'éditeur visuel Directus
SITE_URL=http://localhost:4321

# ---------- Bootstrap (scripts/bootstrap-directus.ts) ----------
# Token statique attribué à l'utilisateur technique "site-web" (généré par toi : openssl rand -hex 32)
DIRECTUS_WEB_TOKEN=change-me-web-token

# ---------- Site Astro (apps/web) ----------
# URL de Directus vue depuis le serveur Astro
DIRECTUS_URL=http://localhost:8055

# ---------- Module « Connexions » de Directus (voir README « Connexions Google et Instagram ») ----------
# Application OAuth Google Cloud (type « Application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Application Meta : identifiant et clé secrète de l'app Instagram (API Instagram avec connexion Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

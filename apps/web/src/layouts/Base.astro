---
import "@/styles/global.css";
import { Font } from "astro:assets";
import VisualEditing from "@/components/VisualEditing.astro";
import Logo from "@/components/Logo.astro";
import Emblem from "@/components/Emblem.astro";
import Icon from "@/components/Icon.astro";
import { editable } from "@/lib/visual-editing";
import { assetUrl } from "@/lib/directus";
import { telHref, lines, postalAddress } from "@/lib/format";

interface Props {
  title?: string;
  description?: string | null;
  image?: string | null;
}

const { settings, visualEditing } = Astro.locals;
const siteName = settings?.site_name ?? "Ohana Lodge";
const { title, description = settings?.seo_description, image = settings?.hero_image } = Astro.props;
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = assetUrl(image, { width: 1200, height: 630, format: "webp" });
const phone = settings?.phone;
const hhmm = (t: string | null | undefined) => t?.slice(0, 5);

// Données structurées : aident Google ET les moteurs IA (GEO) à comprendre l'activité
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BedAndBreakfast",
  name: siteName,
  description: settings?.seo_description ?? undefined,
  url: Astro.site?.toString(),
  email: settings?.contact_email ?? undefined,
  telephone: phone ?? undefined,
  address: postalAddress(settings?.address),
  geo:
    settings?.latitude && settings?.longitude
      ? { "@type": "GeoCoordinates", latitude: settings.latitude, longitude: settings.longitude }
      : undefined,
  image: ogImage,
  checkinTime: hhmm(settings?.checkin_from),
  checkoutTime: hhmm(settings?.checkout_until),
  petsAllowed: false,
  smokingAllowed: false,
  numberOfRooms: 4,
  amenityFeature: ["Piscine", "Petit-déjeuner inclus", "Wi-Fi gratuit", "Terrasse privative"].map((name) => ({
    "@type": "LocationFeatureSpecification",
    name,
    value: true,
  })),
};

const nav = [
  { href: "/#chambres", label: "Chambres" },
  { href: "/#tarifs", label: "Tarifs" },
  { href: "/#lodge", label: "Le lodge" },
  { href: "/#infos", label: "Infos pratiques" },
  { href: "/#acces", label: "Accès" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-inter-tight" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    {visualEditing && <meta name="robots" content="noindex" />}
  </head>
  <body class="flex min-h-dvh flex-col pb-[84px] md:pb-0">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-night focus:px-4 focus:py-2 focus:text-white">
      Aller au contenu
    </a>

    <header class="sticky top-0 z-20 border-b border-line bg-paper/95 backdrop-blur">
      <div class="mx-auto flex h-[60px] max-w-[1240px] items-center justify-between gap-4 px-4 md:h-[72px] md:px-6">
        <Logo />
        <nav aria-label="Navigation principale" class="hidden items-center gap-7 text-[15px] lg:flex">
          {nav.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <div class="flex items-center gap-2">
          <details class="mobile-menu relative lg:hidden">
            <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full [&::-webkit-details-marker]:hidden">
              <span class="sr-only">Menu</span>
              <Icon name="menu" class="menu-open" />
              <Icon name="close" class="menu-close hidden" />
            </summary>
            <nav aria-label="Menu" class="absolute top-full right-0 mt-2 flex w-60 flex-col rounded-2xl border border-line bg-white p-2 shadow-[0_16px_40px_rgba(17,17,17,0.12)]">
              {nav.map((l) => (
                <a href={l.href} class="rounded-lg px-4 py-3 hover:bg-paper">
                  {l.label}
                </a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <footer class="mt-30 bg-ink text-cloud">
      <div class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-8 px-4 pt-16 pb-10 md:px-6">
        <div class="flex flex-col gap-4" {...settings && editable(visualEditing, "settings", settings.id, ["address", "phone"])}>
          <Emblem class="h-12 w-auto self-start text-white" />
          <p class="text-sm text-mist">
            Chambres d'hôtes · {lines(settings?.address).join(", ")}
            {phone && (
              <>
                <br />
                <a href={telHref(phone)} class="text-mist hover:text-white">{phone}</a>
              </>
            )}
          </p>
        </div>
        <nav aria-label="Liens de pied de page" class="flex flex-wrap items-start gap-x-7 gap-y-3 text-sm">
          <a href="/conditions-de-vente" class="text-cloud hover:text-white">Conditions de vente</a>
          <a href="/mentions-legales" class="text-cloud hover:text-white">Mentions légales</a>
          <a href="/confidentialite" class="text-cloud hover:text-white">Confidentialité</a>
          {settings?.instagram_url && <a href={settings.instagram_url} class="text-cloud hover:text-white">Instagram</a>}
        </nav>
      </div>
    </footer>

    <div class="fixed inset-x-0 bottom-0 z-20 grid grid-cols-2 gap-2.5 border-t border-line bg-paper/97 px-4 pt-3 pb-[max(20px,env(safe-area-inset-bottom))] md:hidden">
      {phone && (
        <a href={telHref(phone)} class="flex h-[50px] items-center justify-center gap-2 rounded-full border border-ink font-semibold">
          <Icon name="phone" size={18} stroke={1.6} />
          Appeler
        </a>
      )}
      <a href="/#reserver" class:list={["flex h-[50px] items-center justify-center rounded-full bg-night font-semibold text-white hover:text-white", !phone && "col-span-2"]}>
        Réserver
      </a>
    </div>

    {visualEditing && <VisualEditing />}

    <script>
      // Menu mobile : se referme après un clic sur un lien (ancres de la même page)
      document.querySelectorAll<HTMLDetailsElement>(".mobile-menu").forEach((menu) => {
        menu.addEventListener("click", (e) => {
          if ((e.target as Element).closest("a")) menu.open = false;
        });
      });
    </script>
    <style>
      .mobile-menu[open] .menu-open { display: none; }
      .mobile-menu[open] .menu-close { display: block; }
    </style>
  </body>
</html>

---
import Base from "@/layouts/Base.astro";
import RoomCard from "@/components/RoomCard.astro";
import { directus, readItems, published } from "@/lib/directus";

const rooms = await directus.request(
  readItems("rooms", { filter: published, sort: ["sort", "name"], fields: ["id", "slug", "name", "summary", "cover", "price_from"] }),
);
---

<Base title="Chambres">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-4xl">Nos chambres</h1>
    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      {rooms.map((room) => <RoomCard room={room} />)}
    </div>
  </section>
</Base>

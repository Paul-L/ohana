---
// Page de réservation, deux modes :
// - « online »  : Elloha configuré → disponibilités et prix réels par chambre, puis panier + paiement chez Elloha ;
// - « request » : demande sans paiement (formulaire historique), aussi utilisée en secours si Elloha ne répond pas.
import Base from "@/layouts/Base.astro";
import Emblem from "@/components/Emblem.astro";
import Icon from "@/components/Icon.astro";
import { actions, isInputError } from "astro:actions";
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/server";
import { directus, readItems, readSingleton, assetUrl, srcset, published, fileAlts, type BookingForm } from "@/lib/directus";
import { editable } from "@/lib/visual-editing";
import { estimate, eur, formatTime } from "@/lib/pricing";
import { ellohaEnabled } from "@/lib/elloha";

const { settings } = Astro.locals;
const result = Astro.getActionResult(actions.bookingRequest);
const errors = isInputError(result?.error) ? result.error.fields : {};
const globalError = result?.error && !isInputError(result.error) ? result.error.message : null;

const [rooms, seasons, form] = await Promise.all([
  directus.request(readItems("rooms", { filter: published, sort: ["sort", "name"], fields: ["id", "name", "bed", "features"] })),
  directus.request(
    readItems("seasons", {
      filter: published,
      sort: ["sort"],
      fields: ["name", "periods", "price_double", "price_single", "min_nights", "min_nights_weekend", "long_stay_nights", "long_stay_discount"],
    }),
  ),
  directus.request(readSingleton("booking_form")).catch(() => null) as Promise<BookingForm | null>,
]);
const ve = Astro.locals.visualEditing;
const edit = (fields: string | string[], mode: "drawer" | "popover" = "popover") => (form ? editable(ve, "booking_form", form.id, fields, mode) : {});
const heroAlt = (await fileAlts([settings?.hero_image])).get(settings?.hero_image ?? "") ?? "";

// Pré-remplissage depuis la barre de réservation de l'accueil (?arrivee=&depart=&voyageurs=&chambre=)
const q = Astro.url.searchParams;
const isoDate = (v: string | null) => (v && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v : "");
const arrival = isoDate(q.get("arrivee"));
const departure = isoDate(q.get("depart"));
const guests = Math.min(8, Math.max(1, Number(q.get("voyageurs")) || 2));
const preselected = Number(q.get("chambre")) || undefined;
const today = new Date().toISOString().slice(0, 10);

const touristTax = settings?.tourist_tax ?? 0;
const depositPercent = settings?.deposit_percent ?? 30;
const est = estimate({ seasons, arrival, departure, guests, touristTax, depositPercent });
const pricing = { seasons, touristTax, depositPercent, rooms: rooms.map((r) => ({ id: r.id, name: r.name })) };

const checkin = settings?.checkin_from && settings?.checkin_to ? `${formatTime(settings.checkin_from)} – ${formatTime(settings.checkin_to)}` : null;
const checkout = settings?.checkout_until ? `avant ${formatTime(settings.checkout_until)}` : null;
const done = result?.data?.ok;
const doneRoom = result?.data?.roomName;
// Après l'envoi d'une demande (ou une erreur de validation), on reste en mode « demande »
const mode = ellohaEnabled && !result ? "online" : "request";
---

<Base
  title={mode === "online" ? (form?.online_title ?? "Réserver") : "Demande de réservation"}
  description={mode === "online" ? "Réservation directe au meilleur tarif, paiement sécurisé." : "Demande de réservation directe, sans commission ni paiement en ligne."}
  variant="minimal"
>
  {
    done ? (
      <section class="mx-auto flex max-w-[640px] flex-col items-center gap-5 px-6 py-30 text-center" role="status">
        <Icon name="check" size={56} />
        <h1 class="font-display text-[40px] leading-[1.1] font-light" {...edit("success_title")}>{form?.success_title ?? "Demande envoyée, merci !"}</h1>
        {form?.success_text && <p class="text-body" {...edit("success_text")}>{form.success_text}</p>}
        {doneRoom && (
          <p class="text-sm text-muted">
            Chambre demandée : <strong class="text-ink">{doneRoom}</strong>
          </p>
        )}
        <div class="mt-3 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn-outline">Retour à l'accueil</a>
          <a href="/reserver" class="inline-flex min-h-11 items-center px-5 font-semibold underline underline-offset-4">Nouvelle demande</a>
        </div>
      </section>
    ) : (
      <form
        id="booking"
        method="POST"
        action={actions.bookingRequest}
        data-mode={mode}
        class="mx-auto grid max-w-[1120px] items-start gap-12 px-4 pt-8 pb-24 md:px-6 md:pt-12 lg:grid-cols-[minmax(0,1fr)_360px]"
      >
        <div class="flex min-w-0 flex-col gap-12">
          <div>
            <h1 class="request-only mb-2 font-display text-[clamp(32px,4vw,44px)] leading-[1.1] font-light tracking-[-0.015em]" {...edit("title")}>
              {form?.title ?? "Demande de réservation"}
            </h1>
            <h1 class="online-only mb-2 font-display text-[clamp(32px,4vw,44px)] leading-[1.1] font-light tracking-[-0.015em]" {...edit("online_title")}>
              {form?.online_title ?? "Réserver votre séjour"}
            </h1>
            {form?.intro && <p class="request-only text-muted" {...edit("intro")}>{form.intro}</p>}
            {form?.online_intro && <p class="online-only text-muted" {...edit("online_intro")}>{form.online_intro}</p>}
          </div>

          {globalError && <p class="rounded-[10px] bg-warn-bg px-4 py-3 text-sm font-medium text-warn" role="alert">{globalError}</p>}
          <!-- Affiché si la réservation en ligne ne répond pas et que la demande prend le relais -->
          <p data-out="fallback" role="status" class="hidden rounded-[10px] bg-warn-bg px-4 py-3 text-sm font-medium text-warn" {...edit("online_error")}>
            {form?.online_error ?? "La réservation en ligne ne répond pas pour le moment. Envoyez-nous une demande : nous vous répondons rapidement."}
          </p>

          <!-- 1. Dates -->
          <section aria-labelledby="s1" class="flex flex-col gap-4">
            <h2 id="s1" class="text-lg font-semibold" {...edit("dates_title")}><span class="font-medium text-muted">1 ·</span> {form?.dates_title ?? "Vos dates"}</h2>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-3">
              <label class="label">
                Arrivée{checkin && ` (${checkin})`}
                <input type="date" name="arrival" required min={today} value={arrival} class="field" data-in="arrival" />
                {errors.arrival && <span class="text-sm text-warn">{errors.arrival.join(", ")}</span>}
              </label>
              <label class="label">
                Départ{checkout && ` (${checkout})`}
                <input type="date" name="departure" required min={today} value={departure} class="field" data-in="departure" />
                {errors.departure && <span class="text-sm text-warn">{errors.departure.join(", ")}</span>}
              </label>
              <label class="label">
                Voyageurs
                <select name="guests" class="field" data-in="guests">
                  {Array.from({ length: 8 }, (_, i) => i + 1).map((n) => (
                    <option value={n} selected={n === guests}>{n} personne{n > 1 ? "s" : ""}</option>
                  ))}
                </select>
              </label>
            </div>
            <p role="alert" data-out="warning" class:list={["request-only rounded-[10px] bg-warn-bg px-4 py-3 text-sm font-medium text-warn", !est.warning && "hidden"]}>
              {est.warning}
            </p>
            {form?.dates_note && <p class="request-only text-sm text-muted" {...edit("dates_note")}>{form.dates_note}</p>}
          </section>

          <!-- 2. Chambre -->
          {rooms.length > 0 && (
            <fieldset class="flex flex-col gap-4">
              <legend class="mb-4 text-lg font-semibold" {...edit("room_title")}>
                <span class="font-medium text-muted">2 ·</span> {form?.room_title ?? "Votre chambre"}
                <span class="online-only text-sm font-normal text-muted" data-out="roomsHint"></span>
              </legend>
              <p role="alert" data-out="none" class="hidden rounded-[10px] bg-warn-bg px-4 py-3 text-sm font-medium text-warn" {...edit("none_available")}>
                {form?.none_available ?? "Aucune chambre n'est disponible à ces dates."}
              </p>
              <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-3">
                {rooms.map((r) => (
                  <label class="room-option flex cursor-pointer flex-col items-start gap-1 rounded-xl border-2 border-line bg-white p-4" data-room={r.id}>
                    <input type="radio" name="room" value={r.id} checked={r.id === preselected} class="sr-only" data-room-name={r.name} />
                    <span class="flex w-full items-baseline justify-between gap-2">
                      <span class="font-display text-lg font-medium">{r.name}</span>
                      <span class="request-only text-sm" data-out="unit">{est.unitPrice ? `${est.unitPrice} € / nuit` : ""}</span>
                      <span class="online-only text-right text-sm" data-room-price></span>
                    </span>
                    <span class="text-sm text-muted">{[r.bed && `Lit ${r.bed}`, r.features].filter(Boolean).join(" · ")}</span>
                    <span class="request-only text-[13px] font-semibold">
                      <span class="when-off text-muted">Choisir</span>
                      <span class="when-on hidden">Sélectionnée</span>
                    </span>
                    <span class="online-only text-[13px] font-semibold" data-room-state>Choisissez vos dates</span>
                  </label>
                ))}
              </div>
              {form?.room_note && <p class="request-only text-sm text-muted" {...edit("room_note")}>{form.room_note}</p>}
            </fieldset>
          )}

          <!-- 3. Coordonnées (mode demande uniquement : en ligne, Elloha les recueille avec le paiement) -->
          <section aria-labelledby="s3" class="request-only flex flex-col gap-4">
            <h2 id="s3" class="text-lg font-semibold" {...edit("contact_title")}><span class="font-medium text-muted">3 ·</span> {form?.contact_title ?? "Vos coordonnées"}</h2>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-3">
              <label class="label">
                Nom et prénom
                <input type="text" name="name" required autocomplete="name" class="field" />
                {errors.name && <span class="text-sm text-warn">{errors.name.join(", ")}</span>}
              </label>
              <label class="label">
                Téléphone
                <input type="tel" name="phone" autocomplete="tel" class="field" />
              </label>
            </div>
            <label class="label">
              E-mail
              <input type="email" name="email" required autocomplete="email" class="field" />
              {errors.email && <span class="text-sm text-warn">{errors.email.join(", ")}</span>}
            </label>
            <label class="label">
              Message (optionnel)
              <textarea name="message" rows="3" placeholder={form?.message_placeholder ?? undefined} class="field h-auto resize-y py-3"></textarea>
            </label>
            <label class="flex items-start gap-2.5 text-sm text-body">
              <input type="checkbox" name="terms" required class="mt-0.5 size-5 shrink-0 accent-night" />
              <span>
                J'ai lu les <a href="/conditions-de-vente" target="_blank" class="underline underline-offset-4">conditions de vente</a>
                {checkin && ` (arrivée ${checkin}, départ ${checkout ?? ""}`}, non-fumeur, animaux non admis).
              </span>
            </label>
            {errors.terms && <span class="text-sm text-warn">{errors.terms.join(", ")}</span>}

            <!-- Honeypot anti-spam : invisible pour les humains -->
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-language="fr"></div>
            <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
          </section>
        </div>

        <!-- Récapitulatif -->
        <aside
          aria-label="Récapitulatif"
          class="flex min-w-0 flex-col gap-4 rounded-2xl bg-white p-6 shadow-[0_12px_40px_rgba(20,24,20,0.08)] lg:sticky lg:top-6"
        >
          {settings?.hero_image && (
            <img
              src={assetUrl(settings.hero_image, { width: 640 })}
              srcset={srcset(settings.hero_image, [400, 640, 900])}
              sizes="(min-width: 1024px) 312px, 100vw"
              alt={heroAlt}
              class="aspect-video w-full rounded-[10px] object-cover"
            />
          )}
          <h2 class="font-display text-xl font-medium">Récapitulatif</h2>

          <!-- Mode demande : estimation à partir des saisons Directus -->
          <dl class="request-only grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-[15px] [&_dd]:text-right [&_dd]:font-medium [&_dd]:whitespace-nowrap [&_dt]:text-muted" aria-live="polite">
            <dt>Chambre</dt><dd data-out="room">{rooms.find((r) => r.id === preselected)?.name ?? "Au choix"}</dd>
            <dt>Saison</dt><dd data-out="season">{est.season?.name ?? "—"}</dd>
            <dt data-out="nightsLabel">{est.nights} nuit{est.nights > 1 ? "s" : ""}</dt><dd data-out="lodging">{eur(est.lodging)}</dd>
            <dt data-row="discount" class:list={["!text-night", !est.discount && "hidden"]}>Long séjour</dt>
            <dd data-row="discount" data-out="discount" class:list={[!est.discount && "hidden"]}>− {eur(est.discount)}</dd>
            <dt>Taxe de séjour</dt><dd data-out="tax">{eur(est.tax)}</dd>
            <dt class="mt-1 border-t border-line pt-2.5 font-semibold !text-ink">Total estimé</dt>
            <dd class="mt-1 border-t border-line pt-2.5 font-display text-[22px]" data-out="total">{eur(est.total)}</dd>
            <dt>Acompte à la confirmation</dt><dd data-out="deposit">{eur(est.deposit)}</dd>
          </dl>

          <!-- Mode en ligne : prix réels Elloha (rempli par le script) -->
          <div class="online-only flex flex-col gap-2 text-[15px]" aria-live="polite">
            <dl data-out="onlineLines" class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 [&_dd]:text-right [&_dd]:font-medium [&_dd]:whitespace-nowrap [&_dt]:text-muted">
              <dt>Chambre</dt><dd>—</dd>
            </dl>
            <p data-out="onlineNotes" class="text-sm text-muted"></p>
          </div>

          <button class="request-only min-h-[52px] rounded-[10px] bg-night text-base font-semibold text-white" {...edit("submit_label")}>
            {form?.submit_label ?? "Envoyer ma demande"}
          </button>
          <button
            type="button"
            data-action="pay"
            disabled
            class="online-only min-h-[52px] rounded-[10px] bg-night text-base font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40"
            {...edit("online_submit_label")}
          >
            {form?.online_submit_label ?? "Réserver et payer"}
          </button>
          <div data-out="payError" role="alert" class="hidden flex-col gap-2 rounded-[10px] bg-warn-bg px-4 py-3 text-sm text-warn">
            <p class="font-medium">Le paiement en ligne n'a pas pu être préparé.</p>
            <a data-out="bookingUrl" href="#" class="hidden font-semibold underline underline-offset-4">Réserver sur la page de notre partenaire</a>
            <button type="button" data-action="request" class="self-start font-semibold underline underline-offset-4">Envoyer une demande sans payer</button>
          </div>
          {form?.online_note && <p class="online-only text-sm text-muted" {...edit("online_note")}>{form.online_note}</p>}

          {form?.reassurance?.length ? (
            <ul class="request-only flex flex-col gap-1.5 text-sm text-body" {...edit("reassurance", "drawer")}>
              {form.reassurance.map((r) => <li>✓ {r.text}</li>)}
            </ul>
          ) : null}
          {form?.online_reassurance?.length ? (
            <ul class="online-only flex flex-col gap-1.5 text-sm text-body" {...edit("online_reassurance", "drawer")}>
              {form.online_reassurance.map((r) => <li>✓ {r.text}</li>)}
            </ul>
          ) : null}
          <button type="button" data-action="request" class="online-only self-start text-sm text-muted underline underline-offset-4">
            Une question avant de réserver ? Envoyez une demande
          </button>
        </aside>

        <!-- Affiché pendant l'envoi / la préparation du paiement -->
        <div data-out="sending" role="status" class="fixed inset-0 z-30 hidden flex-col items-center justify-center gap-6 bg-paper/95 text-center">
          <Emblem loader class="h-auto w-[110px] text-night" />
          <p class="font-display text-2xl font-light" data-out="sendingText">Nous transmettons votre demande…</p>
        </div>
      </form>
    )
  }

  <script type="application/json" id="pricing-data" set:html={JSON.stringify(pricing)} />
  <!-- Sans JavaScript, le paiement en ligne est impossible : on affiche le formulaire de demande -->
  <noscript><style>#booking .request-only { display: revert !important; } #booking .online-only { display: none !important; }</style></noscript>
</Base>

<style>
  .room-option:has(:checked) { border-color: var(--color-night); }
  .room-option:has(:focus-visible) { outline: 2px solid var(--color-night); outline-offset: 2px; }
  .room-option:has(:checked) .when-off { display: none; }
  .room-option:has(:checked) .when-on { display: inline; }
  /* Chambre complète ou non réservable en ligne (maquette : bordure pointillée, grisée) */
  .room-option:has(:disabled) { cursor: not-allowed; border-style: dashed; border-color: var(--color-field); background: #f1eee8; opacity: 0.8; }
  #booking[data-mode="online"] .request-only { display: none !important; }
  #booking[data-mode="request"] .online-only { display: none !important; }
</style>

<script>
  // Amélioration progressive :
  // - mode « demande » : estimation à partir des saisons + écran d'attente à l'envoi ;
  // - mode « en ligne » : disponibilités Elloha via /api/disponibilites, puis panier et paiement chez Elloha.
  import { estimate, eur, type SeasonRule } from "@/lib/pricing";

  type Rate = { price: number; priceBeforePromotion: number | null; freeCancellation: boolean; excluded: string | null; addToCartUrl: string };
  type RoomAvailability = { id: number; status: "available" | "full" | "unlinked"; rates?: Record<string, Rate | null> };
  type Availability =
    | { mode: "request"; reason?: string }
    | { mode: "online"; error?: "dates"; nights: number; roomsNeeded: number; rooms: RoomAvailability[]; bookingUrl: string | null };

  const form = document.querySelector<HTMLFormElement>("#booking");
  const dataEl = document.getElementById("pricing-data");
  if (form && dataEl) {
    const { seasons, touristTax, depositPercent, rooms } = JSON.parse(dataEl.textContent!) as {
      seasons: SeasonRule[];
      touristTax: number;
      depositPercent: number;
      rooms: { id: number; name: string }[];
    };
    const $ = <T extends Element = HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
    const out = (name: string) => form.querySelectorAll<HTMLElement>(`[data-out="${name}"]`);
    const set = (name: string, text: string) => out(name).forEach((el) => (el.textContent = text));
    const show = (name: string, visible: boolean, display = "block") =>
      out(name).forEach((el) => {
        el.classList.toggle("hidden", !visible);
        if (display === "flex") el.classList.toggle("flex", visible);
      });
    const roomName = (id: number) => rooms.find((r) => r.id === id)?.name ?? "";
    const values = () => ({
      arrival: $<HTMLInputElement>('[data-in="arrival"]').value,
      departure: $<HTMLInputElement>('[data-in="departure"]').value,
      guests: Number($<HTMLSelectElement>('[data-in="guests"]').value),
    });

    // ---------------------------------------------------------------- Mode demande (estimation locale)
    const updateEstimate = () => {
      const v = values();
      const e = estimate({ seasons, ...v, touristTax, depositPercent });
      const room = form.querySelector<HTMLInputElement>('input[name="room"]:checked');
      set("room", room?.dataset.roomName ?? "Au choix");
      set("season", e.season?.name ?? "—");
      set("nightsLabel", `${e.nights} nuit${e.nights > 1 ? "s" : ""}${e.unitPrice ? ` × ${e.unitPrice} €` : ""}${e.rooms > 1 ? ` × ${e.rooms} ch.` : ""}`);
      set("lodging", eur(e.lodging));
      set("discount", `− ${eur(e.discount)}`);
      form.querySelectorAll<HTMLElement>('[data-row="discount"]').forEach((el) => el.classList.toggle("hidden", !e.discount));
      set("tax", eur(e.tax));
      set("total", eur(e.total));
      set("deposit", eur(e.deposit));
      set("unit", e.unitPrice ? `${e.unitPrice} € / nuit` : "");
      set("warning", e.warning ?? "");
      out("warning").forEach((el) => el.classList.toggle("hidden", !e.warning));
    };

    const inputs = () => [...form.querySelectorAll<HTMLInputElement>('input[name="room"]')];

    /** Bascule vers la demande sans paiement (secours ou choix du visiteur) */
    const toRequestMode = (fallback: boolean) => {
      form.dataset.mode = "request";
      inputs().forEach((i) => {
        i.type = "radio";
        i.disabled = false;
      });
      show("fallback", fallback);
      show("none", false);
      show("payError", false, "flex");
      updateEstimate();
    };

    // ---------------------------------------------------------------- Mode en ligne (Elloha)
    let data: Extract<Availability, { mode: "online" }> | null = null;
    let controller: AbortController | null = null;

    /** Nombre d'adultes de la i-ème chambre choisie (2 par chambre, la dernière seule si nombre impair) */
    const adultsFor = (index: number, guests: number, count: number) => (guests === 1 ? 1 : guests % 2 === 1 && index === count - 1 ? 1 : 2);
    const rateFor = (room: RoomAvailability, adults: number) => room.rates?.[adults] ?? room.rates?.[2] ?? null;

    const selected = () => inputs().filter((i) => i.checked && !i.disabled).map((i) => Number(i.value));

    const renderOnline = () => {
      const guests = values().guests;
      const needed = data?.roomsNeeded ?? Math.ceil(guests / 2);
      // Plusieurs chambres à choisir : cases à cocher au lieu de boutons radio
      inputs().forEach((i) => (i.type = needed > 1 ? "checkbox" : "radio"));
      set("roomsHint", needed > 1 ? ` · choisissez ${needed} chambres` : "");

      for (const label of form.querySelectorAll<HTMLElement>("[data-room]")) {
        const id = Number(label.dataset.room);
        const input = label.querySelector<HTMLInputElement>("input")!;
        const state = label.querySelector<HTMLElement>("[data-room-state]")!;
        const priceEl = label.querySelector<HTMLElement>("[data-room-price]")!;
        const room = data?.rooms.find((r) => r.id === id);
        priceEl.textContent = "";
        if (!data || data.error) {
          input.disabled = false;
          state.textContent = data?.error ? "Vérifiez vos dates" : "Choisissez vos dates";
          state.style.color = "";
          continue;
        }
        if (room?.status === "available") {
          const rate = rateFor(room, 2);
          input.disabled = false;
          state.textContent = input.checked ? "Sélectionnée" : "Disponible";
          state.style.color = "";
          if (rate) priceEl.textContent = `${eur(rate.price)} le séjour`;
        } else {
          input.disabled = true;
          input.checked = false;
          state.textContent = room?.status === "full" ? "Complet à ces dates" : "Sur demande uniquement";
          state.style.color = "#8a4b2a";
        }
      }
      show("none", Boolean(data && !data.error && !data.rooms.some((r) => r.status === "available")));

      // Récapitulatif en prix réels
      const ids = selected();
      const lines = $<HTMLElement>('[data-out="onlineLines"]');
      lines.replaceChildren();
      const row = (label: string, value: string, strong = false) => {
        const dt = document.createElement("dt");
        const dd = document.createElement("dd");
        dt.textContent = label;
        dd.textContent = value;
        if (strong) {
          dt.className = "mt-1 border-t border-line pt-2.5 font-semibold !text-ink";
          dd.className = "mt-1 border-t border-line pt-2.5 font-display text-[22px]";
        }
        lines.append(dt, dd);
      };
      if (data && !data.error) row("Séjour", `${data.nights} nuit${data.nights > 1 ? "s" : ""} · ${guests} pers.`);
      let total = 0;
      const notes = new Set<string>();
      ids.forEach((id, i) => {
        const room = data?.rooms.find((r) => r.id === id);
        const rate = room && rateFor(room, adultsFor(i, guests, ids.length));
        if (!rate) return;
        total += rate.price;
        row(roomName(id), eur(rate.price));
        if (rate.excluded) notes.add(`Non inclus : ${rate.excluded}.`);
        notes.add(rate.freeCancellation ? "Annulation gratuite selon les conditions du tarif." : "Tarif non remboursable.");
      });
      if (!ids.length) row("Chambre", "—");
      if (ids.length) row("Total", eur(total), true);
      set("onlineNotes", [...notes].join(" "));

      const ready = Boolean(data && !data.error && ids.length === needed);
      $<HTMLButtonElement>('[data-action="pay"]').disabled = !ready;
    };

    const refresh = async () => {
      const v = values();
      controller?.abort();
      if (!v.arrival || !v.departure) {
        data = null;
        return renderOnline();
      }
      controller = new AbortController();
      form.querySelectorAll<HTMLElement>("[data-room-state]").forEach((el) => (el.textContent = "Vérification…"));
      try {
        const params = new URLSearchParams({ arrivee: v.arrival, depart: v.departure, voyageurs: String(v.guests) });
        const res = await fetch(`/api/disponibilites?${params}`, { signal: controller.signal });
        const body = (await res.json()) as Availability;
        if (body.mode === "request") return toRequestMode(true);
        data = body;
        renderOnline();
      } catch (err) {
        if ((err as Error).name !== "AbortError") toRequestMode(true);
      }
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    const onChange = (e: Event) => {
      if (form.dataset.mode === "request") return updateEstimate();
      const target = e.target as HTMLElement;
      if (target.matches("[data-in]")) {
        clearTimeout(timer);
        timer = setTimeout(refresh, 300);
      } else renderOnline();
    };

    // ---------------------------------------------------------------- Paiement : panier Elloha puis page de paiement
    const sending = (visible: boolean, text?: string) => {
      if (text) set("sendingText", text);
      show("sending", visible, "flex");
    };

    $<HTMLButtonElement>('[data-action="pay"]').addEventListener("click", async () => {
      if (!data) return;
      const guests = values().guests;
      const ids = selected();
      const added: string[] = [];
      show("payError", false, "flex");
      sending(true, "Préparation du paiement sécurisé…");
      try {
        let paymentUrl = "";
        for (const [i, id] of ids.entries()) {
          const rate = rateFor(data.rooms.find((r) => r.id === id)!, adultsFor(i, guests, ids.length));
          if (!rate) throw new Error("tarif introuvable");
          // Appel côté navigateur (exigé par Elloha) : le panier est lié à la session du visiteur
          const res = await fetch(rate.addToCartUrl, { credentials: "include" });
          const cart = (await res.json()) as { IsSuccess: boolean; ErrorMessage?: string; PaymentUrl?: string; RemoveFromCartUrl?: string };
          if (!cart.IsSuccess) throw new Error(cart.ErrorMessage || "ajout au panier refusé");
          if (cart.RemoveFromCartUrl) added.push(cart.RemoveFromCartUrl);
          paymentUrl = cart.PaymentUrl ?? paymentUrl;
        }
        if (!paymentUrl) throw new Error("page de paiement absente");
        window.location.href = paymentUrl;
      } catch (err) {
        console.error("[elloha]", err);
        // On vide ce qui a été ajouté pour ne pas laisser un panier à moitié rempli
        await Promise.allSettled(added.map((url) => fetch(url, { credentials: "include" })));
        sending(false);
        const link = $<HTMLAnchorElement>('[data-out="bookingUrl"]');
        if (data.bookingUrl) link.href = data.bookingUrl;
        link.classList.toggle("hidden", !data.bookingUrl);
        show("payError", true, "flex");
      }
    });

    form.querySelectorAll<HTMLButtonElement>('[data-action="request"]').forEach((b) => b.addEventListener("click", () => toRequestMode(false)));

    // ---------------------------------------------------------------- Commun
    // Le départ ne peut pas précéder l'arrivée
    const arrivalInput = $<HTMLInputElement>('[data-in="arrival"]');
    arrivalInput.addEventListener("change", () => {
      const dep = $<HTMLInputElement>('[data-in="departure"]');
      dep.min = arrivalInput.value;
      if (dep.value && dep.value <= arrivalInput.value) dep.value = "";
    });

    form.addEventListener("input", onChange);
    form.addEventListener("change", onChange);
    if (form.dataset.mode === "online") refresh();
    else updateEstimate();

    form.addEventListener("submit", (e) => {
      // En ligne, seul le bouton « Réserver et payer » fait avancer (pas d'envoi du formulaire de demande)
      if (form.dataset.mode === "online") return e.preventDefault();
      sending(true, "Nous transmettons votre demande…");
    });
    // Retour arrière (bfcache, ex. depuis la page de paiement) : on masque l'écran d'attente
    window.addEventListener("pageshow", () => sending(false));
  }
</script>

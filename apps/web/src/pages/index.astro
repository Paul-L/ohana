---
import Base from "@/layouts/Base.astro";
import RoomCard from "@/components/RoomCard.astro";
import Icon from "@/components/Icon.astro";
import Stars from "@/components/Stars.astro";
import Lines from "@/components/Lines.astro";
import EllohaWidget from "@/components/EllohaWidget.astro";
import { directus, readItems, readSingleton, assetUrl, srcset, published, fileAlts, type Home, type HomeFile, type Review, type InstagramPost } from "@/lib/directus";
import { editable } from "@/lib/visual-editing";
import { formatPeriods, seasonConditions, eur } from "@/lib/pricing";
import { telHref, lines, scoreValue, stripTags } from "@/lib/format";
import { HERO_OVERLAY, cssGradient } from "@/lib/hero-overlay";

const { settings, visualEditing: ve } = Astro.locals;

const filesFields = ["directus_files_id", "sort"] as const;
// Avis Google (synchro nocturne) : 4 et 5 étoiles, avec texte, conservés moins de 30 jours (règles Google)
const reviewsSince = new Date(Date.now() - 30 * 86_400_000).toISOString();
const [home, [lodge], rooms, seasons, faq, reviews, instagram] = await Promise.all([
  directus
    .request(readSingleton("home", { fields: ["*", { lodge_images: [...filesFields] }, { gallery: [...filesFields] }] }))
    .catch(() => null) as Promise<Home | null>,
  directus.request(readItems("pages", { filter: { ...published, slug: { _eq: "accueil" } }, limit: 1 })),
  directus.request(
    readItems("rooms", { filter: published, sort: ["sort", "name"], fields: ["id", "slug", "name", "cover", "price_from", "capacity", "bed", "features"] }),
  ),
  directus.request(readItems("seasons", { filter: published, sort: ["sort"] })),
  directus.request(readItems("faq", { filter: published, sort: ["sort"] })),
  directus
    .request(
      readItems("reviews", {
        filter: { visible: { _eq: true }, rating: { _gte: 4 }, text: { _nnull: true }, synced_at: { _gte: reviewsSince } },
        sort: ["-published_at"],
        limit: 6,
        fields: ["id", "rating", "author", "published_at", "text"],
      }),
    )
    .catch(() => [] as Review[]),
  // Photos Instagram (synchro hebdomadaire) : les 5 plus récentes remplacent la galerie saisie à la main
  directus
    .request(
      readItems("instagram_posts", {
        filter: { visible: { _eq: true }, image: { _nnull: true } },
        sort: ["-posted_at"],
        limit: 5,
        fields: ["id", "image", "permalink"],
      }),
    )
    .catch(() => [] as InstagramPost[]),
]);

const sorted = (files: HomeFile[] | undefined) => [...(files ?? [])].sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0)).map((f) => f.directus_files_id);
const lodgeImages = sorted(home?.lodge_images).slice(0, 3);
const instagramPhotos = instagram.length >= 5 ? instagram : [];
const gallery: { id: string; href?: string }[] = instagramPhotos.length
  ? instagramPhotos.map((p) => ({ id: p.image!, href: p.permalink }))
  : sorted(home?.gallery).slice(0, 5).map((id) => ({ id }));
// Textes alternatifs saisis dans la médiathèque (description ou titre de chaque image)
const alts = await fileAlts([settings?.hero_image, home?.booking_image, ...lodgeImages, ...gallery.map((g) => g.id), ...rooms.map((r) => r.cover)]);
const alt = (id: string | null | undefined) => (id && alts.get(id)) || "";

const minPrice = Math.min(...seasons.map((s) => s.price_double ?? Infinity));
const fallbackPrice = Number.isFinite(minPrice) ? minPrice : null;

const sourceName = { google: "Google", booking: "Booking.com", tripadvisor: "Tripadvisor" } as const;
const ratings = (home?.ratings ?? []).filter((r) => r.score);
const heroRatings = ratings.filter((r) => r.source === "google" || r.source === "booking");
const ratingsLabel = heroRatings.map((r) => `${r.score} sur ${r.scale} sur ${sourceName[r.source]}`).join(" et ");
const reviewsUrl = ratings.find((r) => r.url)?.url;
const googleReviewsUrl = ratings.find((r) => r.source === "google")?.url;
// « Marie Dupont » → « Marie D. » (avis anonymes : « Un voyageur »)
const shortName = (name: string | null) => {
  const parts = (name ?? "").trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return "Un voyageur";
  return parts.length > 1 ? `${parts[0]} ${parts.at(-1)![0]}.` : parts[0];
};
const monthYear = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString("fr-FR", { month: "long", year: "numeric" }) : "");
const longDate = (iso: string | null | undefined) => (iso ? new Date(iso).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" }) : "");

const touristTax = settings?.tourist_tax;
const phone = settings?.phone;
const instagramHandle = settings?.instagram_url?.match(/instagram\.com\/([^/?#]+)/)?.[1];

const lat = settings?.latitude;
const lon = settings?.longitude;
const mapSrc =
  lat && lon
    ? `https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.012},${lat - 0.006},${lon + 0.012},${lat + 0.006}&layer=mapnik&marker=${lat},${lon}`
    : null;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(lat && lon ? `${lat},${lon}` : lines(settings?.address).join(", "))}`;

const faqLd = faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((q) => ({ "@type": "Question", name: q.question, acceptedAnswer: { "@type": "Answer", text: stripTags(q.answer) } })),
    }
  : null;

// Attributs d'édition visuelle d'un bloc de la page d'accueil
const edit = (fields: string | string[], mode: "drawer" | "popover" = "popover") => (home ? editable(ve, "home", home.id, fields, mode) : {});
const steps = home?.booking_steps ?? [];
const tiers = home?.cancellation_tiers ?? [];
const settingsEdit = (fields: string | string[]) => (settings ? editable(ve, "settings", settings.id, fields) : {});
const tierStyles = ["bg-white text-ink", "bg-clay text-white", "bg-night text-white"];
const h2 = "title-xl";
---

<Base description={lodge?.seo_description}>
  {faqLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <!-- HERO -->
  <section class="relative h-[380px] md:h-[500px]">
    {
      settings?.hero_image && (
        <img
          src={assetUrl(settings.hero_image, { width: 1920 })}
          srcset={srcset(settings.hero_image, [640, 960, 1280, 1920, 2560])}
          sizes="100vw"
          alt={alt(settings.hero_image)}
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover object-[50%_55%]"
          {...editable(ve, "settings", settings.id, "hero_image", "drawer")}
        />
      )
    }
    <!--
      Voile en dégradé : sombre seulement sous le texte (bas, + gauche sur desktop), la photo garde sa lumière ailleurs.
      Réglages dans src/lib/hero-overlay.ts. Après un changement de photo : `pnpm check:contrast`.
    -->
    <div aria-hidden="true" class="absolute inset-0" style={`background: rgb(17 17 17 / ${HERO_OVERLAY.base})`}></div>
    <div aria-hidden="true" class="absolute inset-0" style={`background-image: ${cssGradient("to top", HERO_OVERLAY.fromBottom)}`}></div>
    <div aria-hidden="true" class="absolute inset-0 hidden md:block" style={`background-image: ${cssGradient("to right", HERO_OVERLAY.fromLeftDesktop)}`}></div>
    <div class="relative mx-auto flex h-full max-w-[1240px] flex-col justify-end px-5 pb-6 text-white md:px-6 md:pb-12">
      {
        home?.hero_eyebrow && (
          <p class="mb-2 text-xs font-medium tracking-[0.14em] uppercase md:mb-3 md:text-sm" {...edit("hero_eyebrow")}>
            {home.hero_eyebrow}
          </p>
        )
      }
      <h1
        class="max-w-[760px] font-display text-[34px] leading-[1.06] font-light tracking-[-0.02em] md:text-[clamp(38px,4.8vw,64px)] md:leading-[1.04]"
        {...settings && editable(ve, "settings", settings.id, "tagline")}
      >
        {settings?.tagline ?? settings?.site_name ?? "Ohana Lodge"}
      </h1>
      {
        heroRatings.length > 0 && (
          <a
            href="#avis"
            aria-label={`Note de ${ratingsLabel}, lire les avis`}
            class="mt-4 inline-flex min-h-11 flex-wrap items-center gap-3 self-start rounded-full bg-white py-1.5 pr-4 pl-3 text-sm text-ink shadow-[0_8px_24px_rgba(0,0,0,0.18)] md:mt-7 md:min-h-12 md:pr-[18px] md:text-[15px]"
            {...edit("ratings", "drawer")}
          >
            {heroRatings.map((r, i) => (
              <>
                {i > 0 && <span aria-hidden="true" class="h-6 w-px bg-line" />}
                <span class="inline-flex items-center gap-2" aria-hidden="true">
                  <span class="text-xs font-medium text-muted">{sourceName[r.source]}</span>
                  {r.scale === 5 ? (
                    <>
                      <Stars score={scoreValue(r.score)} />
                      <strong>{r.score}</strong>
                    </>
                  ) : (
                    <>
                      <strong class="inline-flex h-[26px] min-w-[34px] items-center justify-center rounded-[6px_6px_6px_0] bg-night px-1.5 text-sm text-white">{r.score}</strong>
                      {r.label && <span class="hidden text-sm text-body sm:inline">{r.label}</span>}
                    </>
                  )}
                </span>
              </>
            ))}
          </a>
        )
      }
    </div>
  </section>

  <!-- INFOS CLÉS : bandeau noir collé sous la photo -->
  {
    home?.key_facts?.length ? (
      <section aria-label="L'essentiel" class="bg-night px-2 py-1 md:px-6 md:pt-4 md:pb-[76px]" {...edit("key_facts", "drawer")}>
        <dl class="mx-auto grid max-w-[1392px] grid-cols-3 md:flex md:flex-wrap md:items-center md:justify-center md:gap-y-4">
          {home.key_facts.map((f, i) => (
            <div
              class:list={[
                "flex flex-col items-center gap-1.5 border-night-line px-1 py-3 text-center md:flex-row md:gap-3 md:px-5 md:py-2 md:text-left",
                // mobile : grille 3 colonnes ; desktop : une ligne séparée par des filets
                i % 3 !== 0 && "border-l",
                i >= 3 && "border-t md:border-t-0",
                i > 0 ? "md:border-l" : "md:border-l-0",
              ]}
            >
              <Icon name={f.icon} size={22} class="size-6 text-paper md:size-5" />
              <div class="flex flex-col-reverse md:flex-col">
                <dt class="text-[11px] tracking-[0.08em] text-stone uppercase md:text-[10.5px]">{f.label}</dt>
                <dd class="font-display text-[13px] leading-tight font-medium text-white md:mt-0 md:text-base md:whitespace-nowrap">{f.value}</dd>
              </div>
            </div>
          ))}
        </dl>
      </section>
    ) : null
  }

  <!-- BARRE DE RÉSERVATION -->
  <section id="reserver" aria-label="Réserver en ligne" class="relative z-10 mx-auto mt-4 max-w-[1240px] px-4 md:-mt-[60px] md:px-6">
    <div class="rounded-2xl bg-white p-4 shadow-[0_16px_40px_rgba(17,17,17,0.18)] md:p-5">
      <EllohaWidget phone={phone} email={settings?.contact_email} />
    </div>
  </section>

  <!-- CHAMBRES -->
  <section id="chambres" class="mx-auto mt-12 max-w-[1240px] md:mt-30 md:px-6">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-4 px-4 md:mb-10 md:px-0">
      <div>
        <p class="eyebrow mb-2 hidden md:block" {...edit("rooms_eyebrow")}>{home?.rooms_eyebrow}</p>
        <h2 class={h2}>
          <span class="md:hidden" {...edit("rooms_eyebrow")}>{home?.rooms_eyebrow}</span>
          <span class="hidden md:inline" {...edit("rooms_title")}><Lines text={home?.rooms_title} /></span>
        </h2>
      </div>
      {home?.rooms_intro && <p class="max-w-[420px] text-muted" {...edit("rooms_intro")}>{home.rooms_intro}</p>}
    </div>
    <div class="flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 md:grid md:grid-cols-[repeat(auto-fit,minmax(260px,1fr))] md:gap-6 md:overflow-visible md:px-0 md:pb-0">
      {rooms.map((room) => <RoomCard room={room} alt={alt(room.cover)} fallbackPrice={fallbackPrice} class="w-[280px] shrink-0 snap-start md:w-auto" />)}
    </div>
  </section>

  <!-- TARIFS -->
  {
    seasons.length > 0 && (
      <section id="tarifs" class="mx-auto mt-12 max-w-[1240px] px-4 md:mt-[140px] md:px-6">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-4 md:mb-10">
          <div>
            <p class="eyebrow mb-2" {...edit("rates_eyebrow")}>{home?.rates_eyebrow}</p>
            <h2 class={h2} {...edit("rates_title")}>
              <Lines text={home?.rates_title} />
            </h2>
          </div>
          {home?.rates_intro && <p class="max-w-[420px] text-muted" {...edit("rates_intro")}>{home.rates_intro}</p>}
        </div>

        <div class="grid gap-2 md:grid-cols-[repeat(auto-fit,minmax(260px,1fr))] md:gap-4">
          {seasons.map((s) => {
            const { stay, discount } = seasonConditions(s);
            const periods = s.periods_note ? lines(s.periods_note) : formatPeriods(s.periods);
            const dark = s.highlight;
            return (
              <article
                class:list={[
                  "flex flex-col gap-3 rounded-2xl p-4 md:gap-[18px] md:p-7",
                  dark ? "bg-ink text-paper" : "border border-line bg-white",
                ]}
                {...editable(ve, "seasons", s.id, ["name", "periods", "periods_note", "price_double", "price_single", "min_nights", "min_nights_weekend", "long_stay_nights", "long_stay_discount", "highlight"], "drawer")}
              >
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="font-display text-[17px] font-medium md:text-[22px]">{s.name}</h3>
                    <p class:list={["mt-0.5 text-[13px] md:mt-1.5 md:text-[15px]", dark ? "text-mist" : "text-muted"]}>
                      {periods.map((p, i) => (
                        <>
                          {i > 0 && <br class="hidden md:inline" />}
                          {i > 0 && <span class="md:hidden"> · </span>}
                          {p}
                        </>
                      ))}
                    </p>
                  </div>
                  <p class="shrink-0 text-right md:hidden">
                    <span class="block font-display text-2xl leading-tight font-medium">{s.price_double} €</span>
                    <span class:list={["text-xs", dark ? "text-mist" : "text-muted"]}>pour 2 · {s.price_single} € seul</span>
                  </p>
                </div>
                <dl
                  class:list={[
                    "hidden grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-2 border-y py-4 md:grid",
                    dark ? "border-night-line" : "border-line",
                  ]}
                >
                  <dt class={dark ? "text-cloud" : "text-body"}>2 personnes</dt>
                  <dd class="text-right font-display text-[28px] leading-none font-medium">{s.price_double} €</dd>
                  <dt class={dark ? "text-cloud" : "text-body"}>1 personne</dt>
                  <dd class="text-right font-display text-xl leading-tight font-medium">{s.price_single} €</dd>
                </dl>
                <p class:list={["text-xs md:text-sm", dark ? "text-cloud" : "text-body"]}>
                  {stay}
                  {discount && (
                    <>
                      {" · "}
                      <strong>{discount}</strong>
                    </>
                  )}
                </p>
                <a
                  href="#reserver"
                  class:list={[
                    "mt-auto hidden min-h-12 items-center justify-center rounded-[10px] font-semibold md:flex",
                    dark ? "bg-paper text-ink hover:text-ink" : "border border-ink",
                  ]}
                >
                  Réserver
                </a>
              </article>
            );
          })}
        </div>

        <p class="mt-3 flex flex-wrap gap-x-7 gap-y-1 text-[13px] text-body md:mt-5 md:text-sm" {...edit("rates_notes", "drawer")}>
          {(home?.rates_notes ?? []).map((n) => <span>{n.text}</span>)}
          {touristTax != null && <span>Taxe de séjour en sus : {eur(touristTax)} / nuit / pers.</span>}
        </p>
      </section>
    )
  }

  <!-- RÉSERVER EN DIRECT -->
  <section id="reserver-direct" aria-labelledby="rd-title" class="mt-12 bg-sand py-12 md:mt-30 md:py-24">
    <div class="mx-auto grid max-w-[1240px] items-stretch gap-10 px-4 md:grid-cols-2 md:gap-16 md:px-6">
      {
        home?.booking_image && (
          <img
            src={assetUrl(home.booking_image, { width: 1000 })}
            srcset={srcset(home.booking_image, [480, 800, 1200])}
            sizes="(min-width: 768px) 50vw, 100vw"
            alt={alt(home.booking_image)}
            loading="lazy"
            decoding="async"
            class="reveal hidden size-full min-h-[420px] rounded-2xl object-cover md:block"
            {...edit("booking_image", "drawer")}
          />
        )
      }
      <div class="flex flex-col gap-10">
        <div>
          <p class="eyebrow mb-2" {...edit("booking_eyebrow")}>{home?.booking_eyebrow}</p>
          <h2 id="rd-title" class="font-display text-[30px] leading-[1.1] font-light tracking-[-0.015em] md:text-[clamp(30px,3.2vw,42px)]" {...edit("booking_title")}>
            {home?.booking_title}
          </h2>
        </div>
        {
          steps.length > 0 && (
            <ol {...edit("booking_steps", "drawer")}>
              {steps.map((step, i) => (
                <li class:list={["relative grid grid-cols-[36px_1fr] gap-x-4", i < steps.length - 1 && "pb-[22px]"]}>
                  {i < steps.length - 1 && <span aria-hidden="true" class="absolute top-[38px] bottom-1 left-[17.5px] w-px bg-[#b5ad9e]" />}
                  <span class="flex size-9 items-center justify-center rounded-full bg-night text-[15px] font-semibold text-white">{i + 1}</span>
                  <div class="pt-1.5">
                    <p class="text-[17px] font-semibold">{step.title}</p>
                    {step.text && <p class="mt-0.5 text-[15px] text-body">{step.text}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )
        }
        {
          tiers.length > 0 && (
            <div>
              <h3 class="mb-3.5 text-[13px] font-semibold tracking-[0.14em] text-body uppercase" {...edit("cancellation_title")}>{home?.cancellation_title}</h3>
              <div class="flex overflow-hidden rounded-[10px]" {...edit("cancellation_tiers", "drawer")}>
                {tiers.map((t, i) => (
                  <div class:list={["flex flex-col gap-0.5 px-3.5 pt-3.5 pb-3", i === 0 ? "flex-[1.3]" : "flex-1", tierStyles[Math.min(i, tierStyles.length - 1)]]}>
                    <span class="font-display text-[22px] leading-[1.1] font-medium">{t.value}</span>
                    <span class="text-[13px]">{t.label}</span>
                  </div>
                ))}
              </div>
              {home?.cancellation_note && <p class="mt-2.5 text-sm text-body" {...edit("cancellation_note")}>{home.cancellation_note}</p>}
            </div>
          )
        }
        {
          home?.good_to_know?.length ? (
            <div>
              <h3 class="mb-3.5 text-[13px] font-semibold tracking-[0.14em] text-body uppercase" {...edit("good_to_know_title")}>{home.good_to_know_title}</h3>
              <ul class="flex flex-wrap gap-2" {...edit("good_to_know", "drawer")}>
                {home.good_to_know.map((g) => (
                  <li class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2.5 text-[15px]">
                    <Icon name={g.icon} size={18} stroke={1.6} />
                    {g.text}
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }
      </div>
    </div>
  </section>

  <!-- LE LODGE -->
  {
    lodge && (
      <section id="lodge" class="mx-auto mt-12 grid max-w-[1240px] items-center gap-6 px-4 md:mt-30 md:grid-cols-2 md:gap-12 md:px-6">
        {lodgeImages.length > 0 && (
          <div class="grid grid-cols-2 gap-4 max-md:[&>*:not(:first-child)]:hidden" {...edit("lodge_images", "drawer")}>
            {lodgeImages.map((id, i) => (
              <img
                src={assetUrl(id, { width: i === 0 ? 900 : 600 })}
                srcset={srcset(id, i === 0 ? [480, 900, 1200] : [320, 600])}
                sizes={i === 0 ? "(min-width: 768px) 300px, 100vw" : "(min-width: 768px) 300px, 50vw"}
                alt={alt(id)}
                loading="lazy"
                decoding="async"
                class:list={[
                  "reveal w-full rounded-xl object-cover",
                  i === 0 ? "col-span-2 h-[260px] md:col-span-1 md:row-span-2 md:h-full md:min-h-[460px]" : "aspect-square",
                ]}
              />
            ))}
          </div>
        )}
        <div class="flex flex-col gap-3.5 md:gap-5">
          {home?.lodge_eyebrow && (
            <p class="eyebrow hidden md:block" {...edit("lodge_eyebrow")}>
              {home.lodge_eyebrow}
            </p>
          )}
          <h2 class={h2} {...editable(ve, "pages", lodge.id, "title")}>{lodge.title}</h2>
          {lodge.intro && <p class="text-[15px] text-body md:text-base" {...editable(ve, "pages", lodge.id, "intro")}>{lodge.intro}</p>}
          {lodge.content && <div class="lodge-content hidden text-body md:block" set:html={lodge.content} {...editable(ve, "pages", lodge.id, "content", "drawer")} />}
        </div>
      </section>
    )
  }

  <!-- GALERIE -->
  {
    gallery.length > 0 && (
      <section aria-labelledby="galerie" class="mx-auto mt-12 max-w-[1240px] md:mt-[140px] md:px-6">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-4 px-4 md:mb-8 md:px-0">
          <div>
            <p class="eyebrow mb-2 hidden md:block" {...edit("gallery_eyebrow")}>{home?.gallery_eyebrow}</p>
            <h2 id="galerie" class={h2}>
              <span class="md:hidden" {...edit("gallery_eyebrow")}>{home?.gallery_eyebrow}</span>
              <span class="hidden md:inline" {...edit("gallery_title")}>{home?.gallery_title}</span>
            </h2>
          </div>
          {settings?.instagram_url && (
            <a href={settings.instagram_url} class="btn-outline hidden gap-2.5 md:inline-flex">
              <Icon name="instagram" size={18} stroke={1.6} />
              Suivre {instagramHandle ? `@${instagramHandle}` : "le lodge"} sur Instagram
            </a>
          )}
        </div>
        <div
          class="flex snap-x snap-mandatory gap-2.5 overflow-x-auto px-4 pb-2 md:grid md:auto-rows-[260px] md:grid-cols-4 md:gap-3 md:overflow-visible md:px-0 md:pb-0"
          {...(instagramPhotos.length ? {} : edit("gallery", "drawer"))}
        >
          {gallery.map(({ id, href }, i) => {
            const cell = ["reveal h-[300px] w-[240px] shrink-0 snap-start rounded-xl md:size-full", i === 0 && "md:col-span-2 md:row-span-2"];
            const img = (
              <img
                src={assetUrl(id, { width: i === 0 ? 1200 : 600 })}
                srcset={srcset(id, i === 0 ? [480, 800, 1200] : [320, 480, 600])}
                sizes={i === 0 ? "(min-width: 768px) 600px, 240px" : "(min-width: 768px) 300px, 240px"}
                alt={alt(id)}
                loading="lazy"
                decoding="async"
                class:list={href ? "size-full object-cover transition duration-500 group-hover:scale-[1.03]" : [...cell, "object-cover"]}
              />
            );
            return href ? (
              <a href={href} class:list={[...cell, "group block overflow-hidden"]} aria-label={alt(id) ? undefined : "Voir la publication sur Instagram"}>
                {img}
              </a>
            ) : (
              img
            );
          })}
        </div>
        {settings?.instagram_url && (
          <a href={settings.instagram_url} class="link-arrow mx-4 mt-3 md:hidden">
            Suivre {instagramHandle ? `@${instagramHandle}` : "le lodge"} sur Instagram
          </a>
        )}
      </section>
    )
  }

  <!-- AVIS -->
  {
    home && (ratings.length > 0 || home.review_quote || reviews.length > 0) && (
      <section
        id="avis"
        class="mx-auto mt-12 flex max-w-[1040px] flex-col items-center gap-6 px-4 text-center md:mt-[140px] md:px-6"
      >
        <p class="eyebrow" {...edit("reviews_eyebrow")}>{home.reviews_eyebrow}</p>
        {ratings.length > 0 && (
          <ul class="flex w-full flex-wrap gap-3" {...edit("ratings", "drawer")}>
            {ratings.map((r) => {
              const Tag = r.url ? "a" : "div";
              return (
                <li class="flex flex-[1_1_220px]">
                  <Tag href={r.url ?? undefined} class="flex w-full items-center gap-3.5 rounded-[14px] border border-line bg-white px-5 py-[18px] text-left">
                    <span class="flex flex-col gap-0.5">
                      <span class="flex items-center gap-2">
                        <strong class="font-display text-2xl leading-none font-medium">{r.score}</strong>
                        <span class="text-sm text-muted">/ {r.scale}</span>
                        {r.scale === 5 && <Stars score={scoreValue(r.score)} size={15} />}
                      </span>
                      <span class="text-[13px] text-muted">
                        {sourceName[r.source]}
                        {r.count ? ` · ${r.count} avis` : ""}
                        {r.label ? ` · ${r.label}` : ""}
                      </span>
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        )}
        {ratings.length > 0 && (home.ratings_checked_on || home.ratings_synced_at) && (
          <p class="-mt-2 text-[13px] text-muted" {...edit("ratings_checked_on")}>
            {[
              home.ratings_synced_at && ratings.some((r) => r.source === "google") && "Note Google mise à jour chaque jour",
              home.ratings_checked_on && `autres notes relevées le ${longDate(home.ratings_checked_on)}`,
            ]
              .filter(Boolean)
              .join(" · ")
              .replace(/^./, (c) => c.toUpperCase())}
          </p>
        )}
        {reviews.length > 0 && (
          <div class="mt-4 w-full">
            <h3 class="sr-only">Derniers avis Google</h3>
            <ul class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 text-left md:mx-0 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:px-0 md:pb-0">
              {reviews.map((r) => (
                <li class="flex w-[300px] shrink-0 snap-start md:w-auto">
                  <figure class="flex w-full flex-col gap-3 rounded-[14px] border border-line bg-white p-5">
                    <p class="flex items-center gap-2">
                      <Stars score={r.rating} size={15} />
                      <span class="sr-only">{r.rating} étoiles sur 5</span>
                    </p>
                    <blockquote class="line-clamp-6 text-[15px] leading-relaxed text-body">« {r.text} »</blockquote>
                    <figcaption class="mt-auto text-[13px] text-muted">
                      <strong class="font-semibold text-ink">{shortName(r.author)}</strong> · avis Google · {monthYear(r.published_at)}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-[13px] text-muted">
              Sélection des avis Google récents notés 4 ou 5 étoiles, reproduits sans modification. Ces avis ne sont pas vérifiés par nos soins.
              {googleReviewsUrl && (
                <>
                  {" "}
                  <a href={googleReviewsUrl} class="underline underline-offset-4">Voir tous les avis Google</a>
                </>
              )}
            </p>
          </div>
        )}
        {home.review_quote && (
          <figure class="mt-6 flex flex-col items-center gap-6">
            <blockquote class="max-w-[820px] font-display text-[clamp(24px,2.6vw,34px)] leading-[1.3] font-light tracking-[-0.01em]" {...edit("review_quote")}>
              « {home.review_quote} »
            </blockquote>
            {home.review_attribution && (
              <figcaption class="text-[15px] text-muted" {...edit("review_attribution")}>
                {home.review_attribution}
              </figcaption>
            )}
          </figure>
        )}
        {home.review_highlights?.length ? (
          <div class="mt-2 flex flex-col items-center gap-3">
            <ul aria-label="Points forts selon les notes détaillées" class="flex flex-wrap justify-center gap-2" {...edit("review_highlights", "drawer")}>
              {home.review_highlights.map((h) => (
                <li class="rounded-full border border-line bg-white px-3.5 py-2 text-sm font-medium">
                  {h.label} {h.score}
                </li>
              ))}
            </ul>
            {home.review_highlights_note && (
              <p class="text-[13px] text-muted" {...edit("review_highlights_note")}>
                {home.review_highlights_note}
              </p>
            )}
          </div>
        ) : null}
        {reviewsUrl && (
          <a href={reviewsUrl} class="link-arrow self-center">
            Lire tous les avis →
          </a>
        )}
      </section>
    )
  }

  <!-- INFOS PRATIQUES / FAQ -->
  {
    faq.length > 0 && (
      <section id="infos" class="mt-12 bg-sand px-4 py-9 md:mt-[140px] md:py-24">
        <div class="mx-auto grid max-w-[1240px] gap-3 md:grid-cols-2 md:gap-12 md:px-2">
          <div class="flex flex-col gap-4">
            <p class="eyebrow hidden md:block" {...edit("faq_eyebrow")}>{home?.faq_eyebrow}</p>
            <h2 class={h2}>
              <span class="md:hidden" {...edit("faq_eyebrow")}>{home?.faq_eyebrow}</span>
              <span class="hidden md:inline" {...edit("faq_title")}>{home?.faq_title}</span>
            </h2>
            {home?.faq_intro && (
              <p class="hidden text-body md:block">
                <span {...edit("faq_intro")}>{home.faq_intro}</span>
                {phone && (
                  <>
                    {" "}
                    <a href={telHref(phone)} class="underline underline-offset-4">
                      {phone}
                    </a>
                    .
                  </>
                )}
              </p>
            )}
          </div>
          <div class="flex flex-col">
            {faq.map((q, i) => (
              <div class:list={["border-t border-sand-line py-3.5 md:py-5", i === faq.length - 1 && "border-b"]}>
                <h3 class="mb-1 text-[15px] font-semibold md:mb-1.5 md:text-[17px]" {...editable(ve, "faq", q.id, "question")}>
                  {q.question}
                </h3>
                <div class="faq-answer text-sm text-body md:text-base" set:html={q.answer ?? ""} {...editable(ve, "faq", q.id, "answer", "drawer")} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ACCÈS -->
  <section id="acces" class="mx-auto mt-12 grid max-w-[1240px] items-stretch gap-8 px-4 md:mt-30 md:grid-cols-2 md:gap-12 md:px-6">
    <div class="flex flex-col gap-4">
      <p class="eyebrow" {...edit("access_eyebrow")}>{home?.access_eyebrow}</p>
      <div class="flex flex-col gap-4">
        <h2 class={h2} {...settingsEdit("site_name")}>{settings?.site_name ?? "Ohana Lodge"}</h2>
        {
          settings?.address && (
            <address class="text-lg leading-relaxed not-italic" {...settingsEdit(["address", "latitude", "longitude"])}>
              {lines(settings.address).map((l, i) => (
                <>
                  {i > 0 && <br />}
                  {l}
                </>
              ))}
            </address>
          )
        }
        <p class="text-lg">
          {phone && (
            <a href={telHref(phone)} {...settingsEdit("phone")}>
              {phone}
            </a>
          )}
          {phone && settings?.contact_email && <br />}
          {settings?.contact_email && (
            <a href={`mailto:${settings.contact_email}`} {...settingsEdit("contact_email")}>
              {settings.contact_email}
            </a>
          )}
        </p>
      </div>
      <div class="mt-2 flex flex-wrap gap-3">
        <a href={directions} class="btn-outline">Itinéraire</a>
        <a href="#reserver" class="btn-dark">Réserver</a>
      </div>
    </div>
    {
      mapSrc ? (
        <iframe
          src={mapSrc}
          title={`Carte de localisation de ${settings?.site_name ?? "Ohana Lodge"}`}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="min-h-[360px] w-full rounded-xl border-0 bg-sand"
        />
      ) : (
        <div class="min-h-[360px] rounded-xl bg-sand" />
      )
    }
  </section>
</Base>

<style>
  /* Liste « Le lodge » : tirets comme dans la maquette */
  .lodge-content :global(ul) { display: flex; flex-direction: column; gap: 10px; }
  .lodge-content :global(li)::before { content: "— "; }
  .lodge-content :global(p) { margin-bottom: 1rem; }
  .faq-answer :global(a) { text-decoration: underline; text-underline-offset: 4px; }
</style>

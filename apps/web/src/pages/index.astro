---
import Base from "@/layouts/Base.astro";
import RoomCard from "@/components/RoomCard.astro";
import { directus, readItems, assetUrl, published } from "@/lib/directus";
import { editable } from "@/lib/visual-editing";

const { settings, visualEditing: ve } = Astro.locals;

const [home] = await directus.request(
  readItems("pages", { filter: { ...published, slug: { _eq: "accueil" } }, limit: 1 }),
);
const rooms = await directus.request(
  readItems("rooms", { filter: published, sort: ["sort", "name"], fields: ["id", "slug", "name", "summary", "cover", "price_from"] }),
);
---

<Base description={home?.seo_description}>
  <section class="relative h-[70dvh] min-h-[420px] overflow-hidden">
    {
      settings?.hero_image && (
        <img
          src={assetUrl(settings.hero_image, { width: 1920 })}
          srcset={`${assetUrl(settings.hero_image, { width: 768 })} 768w, ${assetUrl(settings.hero_image, { width: 1280 })} 1280w, ${assetUrl(settings.hero_image, { width: 1920 })} 1920w`}
          sizes="100vw"
          alt=""
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
          {...editable(ve, "settings", settings.id, "hero_image", "drawer")}
        />
      )
    }
    <div class="absolute inset-0 bg-ink/30"></div>
    <div class="relative mx-auto flex h-full max-w-5xl flex-col justify-end px-4 pb-12 text-sand-50">
      <h1 class="text-4xl sm:text-6xl" {...settings && editable(ve, "settings", settings.id, ["site_name", "tagline"])}>
        {settings?.site_name ?? "Ohana Lodge"}
      </h1>
      {settings?.tagline && <p class="mt-3 max-w-xl text-lg">{settings.tagline}</p>}
      <a href="/reserver" class="mt-6 w-fit rounded-full bg-sand-50 px-6 py-3 text-ink hover:bg-sand-100">Demander une réservation</a>
    </div>
  </section>

  {
    home && (
      <section class="mx-auto max-w-3xl px-4 py-16" {...editable(ve, "pages", home.id, ["title", "intro", "content"], "drawer")}>
        <h2 class="text-3xl">{home.title}</h2>
        {home.intro && <p class="mt-4 text-lg text-ink/80">{home.intro}</p>}
        {home.content && <div class="prose-ohana" set:html={home.content} />}
      </section>
    )
  }

  {
    rooms.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-20">
        <h2 class="text-3xl">Nos chambres</h2>
        <div class="mt-8 grid gap-10 sm:grid-cols-2">
          {rooms.map((room) => <RoomCard room={room} />)}
        </div>
      </section>
    )
  }
</Base>

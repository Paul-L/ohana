<svg
  viewBox="0 0 911 678"
  class:list={[className, loader && "ohana-loader"]}
  {...label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" }}
>
  <path class="ohana-fill" d={parts.join(" ")} fill="currentColor" fill-rule="evenodd"></path>
  {
    loader && (
      <g fill="none" stroke="currentColor" stroke-width="11" stroke-linejoin="round">
        {parts.map((d) => <path d={d} pathLength="1" />)}
      </g>
    )
  }
</svg>

<style>
  .ohana-loader g path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ohana-trace 3.2s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }
  .ohana-loader .ohana-fill {
    opacity: 0;
    animation: ohana-fillin 3.2s ease-in-out infinite;
  }
  @keyframes ohana-trace {
    0% { stroke-dashoffset: 1; opacity: 1; }
    45% { stroke-dashoffset: 0; opacity: 1; }
    70%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes ohana-fillin {
    0%, 40% { opacity: 0; }
    65%, 85% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ohana-loader g { display: none; }
    .ohana-loader .ohana-fill { opacity: 1; animation: ohana-pulse 2s ease-in-out infinite; }
  }
  @keyframes ohana-pulse { 50% { opacity: 0.4; } }
</style>

---
// Texte multiligne saisi dans Directus : chaque retour à la ligne devient un <br> (à partir de `from`).
interface Props {
  text: string | null | undefined;
  /** "md" : retours à la ligne seulement sur grand écran (titres) */
  from?: "always" | "md";
}
const { text, from = "md" } = Astro.props;
const lines = (text ?? "").split("\n").map((l) => l.trim()).filter(Boolean);
---

{
  lines.map((l, i) => (
    <>
      {i > 0 && <br class={from === "md" ? "hidden md:inline" : undefined} />}
      {i > 0 && from === "md" && <span class="md:hidden"> </span>}
      {l}
    </>
  ))
}

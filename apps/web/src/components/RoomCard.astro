---
import { assetUrl, srcset, type Room } from "@/lib/directus";
import { editable } from "@/lib/visual-editing";

interface Props {
  room: Pick<Room, "id" | "slug" | "name" | "cover" | "price_from" | "capacity" | "bed" | "features">;
  /** Prix "dès" par défaut (plus bas tarif 2 pers.) si la chambre n'en a pas */
  fallbackPrice?: number | null;
  /** Texte alternatif de la photo (médiathèque Directus) */
  alt?: string;
  class?: string;
}
const { room, fallbackPrice, alt = "", class: className } = Astro.props;
const ve = Astro.locals.visualEditing;
const price = room.price_from ?? fallbackPrice;
const edit = (fields: string | string[], mode: "drawer" | "popover" = "popover") => editable(ve, "rooms", room.id, fields, mode);
const details = ["Petit-déj inclus", room.bed && `lit ${room.bed}`, room.features].filter(Boolean).join(" · ");
---

<article class:list={["flex flex-col gap-2 md:gap-3.5", className]}>
  <a href={`/chambres/${room.slug}`} class="block overflow-hidden rounded-xl bg-sand" tabindex="-1" {...edit("cover", "drawer")}>
    {
      room.cover ? (
        <img
          src={assetUrl(room.cover, { width: 800 })}
          srcset={srcset(room.cover, [400, 600, 800, 1200])}
          sizes="(min-width: 1240px) 290px, (min-width: 768px) 45vw, 280px"
          alt={alt}
          loading="lazy"
          decoding="async"
          class="reveal aspect-[7/5] w-full object-cover transition duration-500 hover:scale-[1.03] md:aspect-[4/3]"
        />
      ) : (
        <div class="flex aspect-[7/5] items-center justify-center text-sm text-muted md:aspect-[4/3]">Photo à venir</div>
      )
    }
  </a>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="font-display text-lg font-medium md:text-[22px]" {...edit("name")}>
      <a href={`/chambres/${room.slug}`}>{room.name}</a>
    </h3>
    {
      price && (
        <p class="shrink-0 text-sm text-muted md:text-[15px]" {...edit(["price_from", "capacity"])}>
          dès <strong class="text-ink">{price} €</strong>
          <span class="hidden md:inline">/ nuit{room.capacity && ` · ${room.capacity} pers.`}</span>
        </p>
      )
    }
  </div>
  <p class="text-sm text-muted md:text-[15px]" {...edit(["bed", "features"])}>{details}</p>
  <a href="/#reserver" class="link-arrow hidden md:inline-flex">Voir les disponibilités →</a>
</article>

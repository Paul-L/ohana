---
// Étoiles décoratives (la note elle-même est toujours écrite en texte à côté)
interface Props {
  score: number; // sur 5
  size?: number;
}
const { score, size = 16 } = Astro.props;
const full = Math.round(score);
---

<span aria-hidden="true" class="inline-flex gap-px">
  {
    Array.from({ length: 5 }, (_, i) => (
      <svg width={size} height={size} viewBox="0 0 24 24" class={i < full ? "fill-star" : "fill-line"}>
        <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" />
      </svg>
    ))
  }
</span>

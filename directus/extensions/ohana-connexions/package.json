{
  "name": "directus-extension-ohana-connexions",
  "description": "Connexions Google et Instagram (OAuth) + synchro des avis et des photos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": { "app": "dist/app.js", "api": "dist/api.js" },
    "entries": [
      { "type": "endpoint", "name": "connexions-api", "source": "src/endpoint.ts" },
      { "type": "hook", "name": "connexions-sync", "source": "src/hook.ts" },
      { "type": "module", "name": "connexions", "source": "src/module/index.ts" }
    ],
    "host": "^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.1.2",
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  }
}
